{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "typecheck": "tsc -b --force",
    "check:contrast": "node scripts/check-contrast.mjs",
    "check:colour": "node scripts/check-raw-colour.mjs",
    "check:console": "node scripts/check-console-handshake.mjs",
    "verify": "npm run typecheck && npm run lint && npm run check:colour && npm run check:contrast && npm run check:console && npm run build"
  },
  "dependencies": {
    "@novnc/novnc": "^1.7.0",
    "@tanstack/react-query": "^5.101.4",
    "@types/js-yaml": "^4.0.9",
    "axios": "^1.19.0",
    "js-yaml": "^5.2.3",
    "lucide-react": "^1.29.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "oxlint": "^1.75.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.2.0"
  }
}
