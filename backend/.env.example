# Local IaaS backend configuration.
#
# Copy to `.env` in this directory, or set any of these as environment
# variables. Every value below is the built-in default — the file is only
# needed for overrides.
#
# Three things about how this file is read:
#   * the prefix is IAAS_, uppercased: qemu_dir -> IAAS_QEMU_DIR
#   * it is decoded as utf-8-sig, so a UTF-8 BOM is tolerated
#   * unknown keys are IGNORED, not rejected — a stale setting is harmless,
#     but so is a typo, so check spelling if an override seems to do nothing
#
# List values are JSON.

# --- General ---------------------------------------------------------------
IAAS_APP_NAME=Local IaaS Orchestrator
IAAS_APP_VERSION=0.1.0
# Enables SQL echo. Noisy.
IAAS_DEBUG=false

# --- Database --------------------------------------------------------------
# Lives under IAAS_STATE_DIR with everything else, so the backend opens the
# same database wherever it is started from. Set this to override it — note
# the four slashes for an absolute POSIX path, three for a Windows drive
# letter or a (deliberately) CWD-relative one.
#
#   IAAS_DATABASE_URL=sqlite:////var/lib/local-iaas/iaas.db
#   IAAS_DATABASE_URL=sqlite:///D:/iaas/iaas.db
#
# It used to default to sqlite:///./iaas.db — relative to the process's
# working directory — which meant starting the backend from the repo root
# instead of backend/ opened a *different*, empty database and presented as an
# install that had lost everything.
IAAS_DATABASE_URL=sqlite:///~/.local-iaas/iaas.db

# --- CORS ------------------------------------------------------------------
# Origins allowed to call the API. The Vite dev server defaults.
IAAS_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Optional regex of *additional* allowed origins. Empty (off) by default, and
# intended for development only: Vite moves to the next free port when 5173 is
# taken, and the dashboard then fails every call with a CORS error that
# explains none of that. Uncomment for a session if you hit it — the better fix
# is to free port 5173.
# IAAS_CORS_ORIGIN_REGEX=http://(localhost|127\.0\.0\.1)(:\d+)?

# --- Compute engine --------------------------------------------------------
# Timeout for short-lived hypervisor tool calls (qemu-img, --version probes).
# Boot waits use IAAS_QEMU_BOOT_TIMEOUT_SECONDS instead.
IAAS_CLI_TIMEOUT_SECONDS=30

# --- Reconciliation --------------------------------------------------------
# A hypervisor often reports a VM Running a few seconds before it publishes the
# guest's address, so the post-launch sync keeps sampling rather than pinning
# "Running with no IP" onto the row.
IAAS_POST_LAUNCH_IP_TIMEOUT_SECONDS=60
IAAS_POST_LAUNCH_POLL_SECONDS=2.0
# Background reconcile cadence. 0 disables the loop entirely, leaving only
# POST /instances/refresh.
IAAS_RECONCILE_INTERVAL_SECONDS=30
# A Running instance that expected an address but still has none after this
# long is shown as Degraded rather than healthy.
IAAS_DEGRADED_AFTER_SECONDS=90
# How long an instance's event history is kept. Pruned once at startup, by age
# alone — a terminated instance keeps its events until they age out, because
# "what happened to the VM that is now gone" is the question the log answers.
# 0 disables pruning and keeps everything.
IAAS_EVENT_RETENTION_DAYS=90

# --- Cloud-init & SSH ------------------------------------------------------
# The non-root sudo user created on every cloud-init guest.
IAAS_DEFAULT_VM_USER=iaas
# The orchestrator's keypair. Generated on first use, never regenerated.
IAAS_SSH_KEY_DIR=~/.local-iaas/keys
# Per-instance cloud-init YAML is rendered here, then deleted after launch.
IAAS_CLOUD_INIT_DIR=~/.local-iaas/cloud-init
IAAS_SSH_KEYGEN_BINARY=ssh-keygen

# --- On-disk layout ---------------------------------------------------------
# Root for everything this tool stores: VM disks, the orchestrator keypair,
# boot media, rendered cloud-init. The four directories below default to
# subdirectories of it, so setting this alone moves the lot; setting one of
# them explicitly overrides just that one.
#
# On Linux, the XDG Base Directory layout is:
#   IAAS_STATE_DIR=${XDG_DATA_HOME:-$HOME/.local/share}/local-iaas
# The default stays a dotfile directory on every platform so that upgrading
# never strands an existing install's VMs.
IAAS_STATE_DIR=~/.local-iaas

# --- Database backups ------------------------------------------------------
# A copy of iaas.db is taken automatically immediately before an additive
# migration changes the schema, and at no other time — an ordinary startup on an
# up-to-date database writes nothing. Taken through SQLite's online backup API,
# so each backup is one self-contained file with the WAL folded in and no
# -wal/-shm to keep beside it.
#
# Restore is a manual procedure, documented in CONTRIBUTING.md.
IAAS_DB_BACKUP_DIR=~/.local-iaas/backups
# How many automatic backups to keep; older ones are pruned oldest-first. Files
# in that directory that this backend did not write are never touched. 0 keeps
# everything.
IAAS_DB_BACKUP_RETENTION=5

# --- QEMU ------------------------------------------------------------------
# Working tree: <qemu_dir>/base-images/ and <qemu_dir>/instances/<name>/
IAAS_QEMU_DIR=~/.local-iaas/qemu
# Set these to absolute paths if QEMU is not on PATH. The binary names are the
# same everywhere; only the packaging differs — on Debian/Ubuntu they come from
# `qemu-system-x86` and `qemu-utils`, on Fedora from `qemu-kvm`, and the
# Windows installer does not add them to PATH at all.
IAAS_QEMU_SYSTEM_BINARY=qemu-system-x86_64
IAAS_QEMU_IMG_BINARY=qemu-img

# The built-in image, downloaded once on first launch (~600 MB).
IAAS_QEMU_BASE_IMAGE_URL=https://cloud-images.ubuntu.com/noble/current/noble-server-cloudimg-amd64.img
IAAS_QEMU_BASE_IMAGE_NAME=noble-server-cloudimg-amd64.img
IAAS_QEMU_DOWNLOAD_TIMEOUT_SECONDS=1800

# Guest CPU model. Empty means "pick one that works for the accelerator in
# use": qemu64 under WHPX (which crashes on -cpu max/host with "Unexpected VP
# exit code 4"), host under KVM/HVF (faster, and passes through AES-NI etc.),
# max under software emulation.
IAAS_QEMU_CPU_MODEL=

# Resolvers handed to guests via the NoCloud network-config. QEMU's user-mode
# DNS proxy (10.0.2.3) answers NXDOMAIN for everything on Windows while NAT
# itself works, which silently breaks cloud-init's package installs. On Linux
# the SLIRP resolver is generally fine, so this may be unnecessary there —
# harmless either way, and unverified until the Linux phase. Set to [] to keep
# whatever DHCP/SLIRP supplies.
IAAS_QEMU_GUEST_NAMESERVERS=["1.1.1.1","8.8.8.8"]

# How long provision/start wait for a cloud-init guest's SSH port to answer.
# Software emulation needs the headroom: ~23s accelerated vs ~12 minutes not.
IAAS_QEMU_BOOT_TIMEOUT_SECONDS=600
# Grace period for ACPI powerdown before the process is killed.
IAAS_QEMU_SHUTDOWN_TIMEOUT_SECONDS=90

# Host port pools. Three ports are pinned per instance for its whole life, so a
# copied SSH command keeps working across stop/start. All bind to 127.0.0.1.
IAAS_QEMU_SSH_PORT_MIN=2200
IAAS_QEMU_SSH_PORT_MAX=2299
IAAS_QEMU_QMP_PORT_MIN=4400
IAAS_QEMU_QMP_PORT_MAX=4499
# VNC display N listens on 5900+N; expressed here as real port numbers.
IAAS_QEMU_VNC_PORT_MIN=5900
IAAS_QEMU_VNC_PORT_MAX=5999

# --- Boot media ------------------------------------------------------------
# Drop .iso files here by hand; there is no upload endpoint.
IAAS_ISO_DIR=~/.local-iaas/isos

# --- Sizing presets --------------------------------------------------------
# Starting points the launch form fills in, not limits. JSON object.
IAAS_FLAVORS={"small":{"cpus":1,"memory_mb":1024,"disk_gb":5},"medium":{"cpus":2,"memory_mb":2048,"disk_gb":10},"large":{"cpus":4,"memory_mb":4096,"disk_gb":20}}

# --- Host capacity ---------------------------------------------------------
# Held back for the host OS so a launch cannot drive the machine into swap.
# 2 GiB.
IAAS_HOST_RESERVE_MEMORY_BYTES=2147483648
# vCPUs timeshare, so handing out more than the host has is normal; a single VM
# is still capped at the real core count.
IAAS_CPU_OVERSUBSCRIBE_FACTOR=2.0
# Dashboard polling would otherwise call psutil several times a second.
IAAS_CAPACITY_CACHE_SECONDS=3.0
# Floors below which a guest is not worth booting.
IAAS_MIN_INSTANCE_CPUS=1
IAAS_MIN_INSTANCE_MEMORY_MB=512
IAAS_MIN_INSTANCE_DISK_GB=1
